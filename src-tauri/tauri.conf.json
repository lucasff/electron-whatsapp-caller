{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WhatsApp Caller",
  "version": "0.3.0",
  "identifier": "me.lucasfreitas.WhatsAppCaller",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app", "nsis", "deb", "appimage"],
    "category": "SocialNetworking",
    "shortDescription": "Open tel: and callto: links in WhatsApp",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["tel", "callto", "whatsapp"]
      }
    }
  }
}
